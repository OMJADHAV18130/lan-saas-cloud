# Frontend environment (copy to .env and edit).

# Full API base URL of the Cloud Controller. Leave EMPTY to use the same
# origin / the Vite dev proxy (recommended when the controller serves the
# built frontend, or when developing with `npm run dev`).
# Split deployment example (frontend on one host, controller on another):
#   VITE_API_BASE_URL=http://192.168.1.38:8000/api
VITE_API_BASE_URL=

# Dev-server proxy target: where the FastAPI Cloud Controller listens.
# Set this to the controller's LAN address when developing on another PC.
VITE_API_PROXY_TARGET=http://localhost:8000
