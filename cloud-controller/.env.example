# ---------------------------------------------------------------------------
# Cloud Controller example environment file.
# Copy to `.env` and edit. NEVER commit the real .env file.
# All values below are placeholders - replace them.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=LAN SaaS Cloud Storage
ENVIRONMENT=development            # development | production
# Comma separated list of the EXACT frontend origins allowed by CORS.
# For LAN clients add their origin, e.g. http://192.168.1.38:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Secret used to sign JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_random_48_chars_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# --- Metadata database (SQLite: metadata ONLY, never file contents) --------
DATABASE_URL=sqlite:///./lan_saas.db

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760          # 10 MiB per file (lab default)
MAX_FILES_PER_USER=500

# --- Rate limiting (authentication routes) ---------------------------------
AUTH_RATE_LIMIT_ATTEMPTS=10        # allowed attempts ...
AUTH_RATE_LIMIT_WINDOW_SECONDS=60  # ... per window, per client IP

# --- HDFS / WebHDFS --------------------------------------------------------
# adapter: "webhdfs" (default, real Hadoop) | "mock" (LOCAL DEV ONLY - opt-in)
HDFS_ADAPTER=webhdfs
# NameNode WebHDFS endpoint. NO hardcoded machine IP - set it per installation.
# pseudo-distributed single machine:  http://localhost:9870
# multi machine (NameNode host nn.lab.local): http://nn.lab.local:9870
HDFS_BASE_URL=http://localhost:9870
# Service identity used for all WebHDFS calls (least privilege user, not root)
HDFS_SERVICE_USER=saascloud
# Authentication method: "simple" (user.name query param, lab default)
# Kerberos is NOT supported by this lab build.
HDFS_AUTH=simple
# Root directory inside HDFS owned by the service identity
HDFS_ROOT=/saas-cloud
# Timeout in seconds for NameNode WebHDFS calls
HDFS_TIMEOUT_SECONDS=15
# Optional: NameNode JMX endpoint used ONLY server-side to report live/dead
# DataNodes. Leave empty to report DataNode status as "unknown".
# e.g. http://localhost:9870/jmx
HDFS_JMX_URL=
# Directory used by the mock adapter (ignored when HDFS_ADAPTER=webhdfs)
HDFS_MOCK_DIR=./mock_hdfs_data

# --- First admin bootstrap (optional, safe-by-construction) ----------------
# The first admin is created ONLY if these are set AND the users table is
# empty. Leave both empty in normal operation; there is no default password.
# Prefer: python -m app.bootstrap_admin   (interactive)
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Optional: serve the built React frontend from FastAPI -----------------
# e.g. ../frontend/dist  - enables single-origin LAN deployment (:8000)
STATIC_DIR=
