# ---------------------------------------------------------------------------
# Environment for `docker compose`. Copy to `.env` and edit.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # JWT_SECRET
#
# IMPORTANT: the repository-root .env is for COMPOSE only. The controller keeps
# its own separate .env for non-Docker (direct uvicorn) runs.
# ---------------------------------------------------------------------------

# REQUIRED - compose refuses to start without it.
JWT_SECRET=CHANGE_ME_put_a_random_48_character_string_here

JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Port on the HOST that serves the browser UI + API to the lab LAN.
# 8080 is the default because 8000 is very often already in use on a dev
# machine. Any free port works; only this one is exposed to the LAN.
CONTROLLER_PORT=8080

# Browser origins allowed by CORS. In single-origin mode the SPA is served by
# the controller, so this should match the URL clients actually type, e.g.
#   CORS_ORIGINS=http://192.168.1.20:8080
CORS_ORIGINS=http://localhost:8080

# Upload limits / rate limiting
MAX_UPLOAD_BYTES=10485760
MAX_FILES_PER_USER=500
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
HDFS_TIMEOUT_SECONDS=15

# Optional first-admin bootstrap. Only applied while the users table is EMPTY.
# Leave blank and use the interactive CLI instead:
#   docker compose exec controller python -m app.bootstrap_admin
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
